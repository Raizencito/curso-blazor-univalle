@page "/catalogo"
@using sharpness_sharp.Components.UIComponents

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Open+Sans:wght@300;400&display=swap" rel="stylesheet" />
</HeadContent>

<button @onclick="anadirCafe" class="bg-[#3a2a20] text-[#f8f6ec] hover:bg-[#5a4a3a] text-lg font-bold py-2 px-4 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 border border-[#9c8c80] hover:border-[#5a4a3a]">Añadir Café</button>
<button class="bg-[#3a2a20] text-[#f8f6ec] hover:bg-[#5a4a3a] text-lg font-bold py-2 px-4 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 border border-[#9c8c80] hover:border-[#5a4a3a]" @onclick="MostrarMensaje">Pulsame enenen</button>
<section class="bg-[#f8f6ec] px-6 py-10 sm:px-10 lg:px-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-x-24 gap-y-10 xl:grid-cols-2">
        @foreach (var cafe in lstCafes)
        {
            <CoffeCard Imagen="@cafe.Imagen" NombreCafe="@cafe.NombreCafe" DescripcionCafe="@cafe.DescripcionCafe" PrecioCafe="@cafe.PrecioCafe" />
        }
    </div>
</section>


@foreach(var mensaje in lstMensajes)
{
    <p class="text-lg text-gray-700 rounded-lg bg-[#f8f6ec] p-4 border border-[#d4c8b8]"> @mensaje</p>
}

