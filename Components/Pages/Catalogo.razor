@page "/catalogo"

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Open+Sans:wght@300;400&display=swap" rel="stylesheet" />
</HeadContent>

<section class="bg-[#f8f6ec] px-6 py-10 sm:px-10 lg:px-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-x-24 gap-y-10 xl:grid-cols-2">
        @for (var i = 0; i < 2; i++)
        {
            <div class="@(i == 1 ? "hidden xl:flex" : "flex") items-center justify-center gap-4 text-[#b9a596]">
                <span class="h-px w-20 bg-current"></span>
                <svg viewBox="0 0 40 32" class="h-8 w-10 fill-current" aria-hidden="true">
                    <ellipse cx="20" cy="9" rx="5.5" ry="7.5" transform="rotate(-10 20 9)" />
                    <ellipse cx="11" cy="22" rx="6" ry="8" transform="rotate(-50 11 22)" />
                    <ellipse cx="29" cy="22" rx="6" ry="8" transform="rotate(50 29 22)" />
                    <path d="M20 2.5c-2 4-2 9 0 13M7.5 17c3 2.5 5 5.5 6.5 9.5M32.5 17c-3 2.5-5 5.5-6.5 9.5" stroke="#f8f6ec" stroke-width="1.3" fill="none" stroke-linecap="round" />
                </svg>
                <span class="h-px w-20 bg-current"></span>
            </div>
        }

        @foreach (var cafe in lstCafes)
        {
            <article class="group flex items-start gap-8 sm:gap-12">
                <img src="@cafe.Imagen" alt="@cafe.NombreCafe"
                     class="h-20 w-20 shrink-0 rounded-full object-cover shadow-[0_4px_14px_rgba(60,40,25,0.22)] transition-transform duration-300 group-hover:scale-105 sm:h-[84px] sm:w-[84px]" />
                <div class="min-w-0 flex-1 pt-3">
                    <div class="flex items-baseline gap-2">
                        <h2 class="font-['Marcellus','Georgia',serif] text-xl uppercase tracking-[0.06em] text-[#3a2a20] sm:text-[25px]">@cafe.NombreCafe</h2>
                        <span class="mb-1 min-w-6 flex-1 border-b border-dotted border-[#9c8c80]"></span>
                        <p class="shrink-0 font-['Marcellus','Georgia',serif] text-lg tracking-[0.04em] text-[#3a2a20] sm:text-xl">@cafe.PrecioCafe Bs.</p>
                    </div>
                    <p class="mt-3 font-['Open_Sans','Segoe_UI',sans-serif] text-base font-light leading-snug text-[#6b4a2b] sm:text-[17px]">@cafe.DescripcionCafe</p>
                </div>
            </article>
        }
    </div>
</section>

