@page "/usuarios"
@using sharpness_sharp.Data.Models
@using sharpness_sharp.Data
@inject ApplicationAuthDbContext _dbService

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Open+Sans:wght@300;400&display=swap" rel="stylesheet" />
</HeadContent>

<div>
    <h1>Lista de Usuarios</h1>
    @foreach(var usuario in lstUsuarios)
    {
        <div class="usuario-card">
            <img src="@usuario.ImagenUsuario" alt="@usuario.NombreUsuario" class="usuario-imagen" />
            <div class="usuario-info">
                <h2>@usuario.NombreUsuario</h2>
                <p>Correo: @usuario.CorreoUsuario</p>
                <p>Tamaño PN: @usuario.tamano</p>
                <p>Edad: @usuario.edadUsuario</p>
            </div>
        </div>
    } 
</div>
@code {
    private List<Usuario> lstUsuarios = new();
    protected override Task OnInitializedAsync()
    {
        lstUsuarios = _dbService.Usuarios.ToList();
        return base.OnInitializedAsync();
    }

   
    
}