@page "/usuarios"

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Open+Sans:wght@300;400&display=swap" rel="stylesheet" />
</HeadContent>

<div>
    <h1>Lista de Usuarios</h1>
    @foreach(var usuario in lstUsuarios)
    {
        <div class="usuario-card">
            <img src="@usuario.ImagenUsuario" alt="@usuario.NombreUsuario" class="usuario-imagen" />
            <div class="usuario-info">
                <h2>@usuario.NombreUsuario</h2>
                <p>Correo: @usuario.CorreoUsuario</p>
                <p>Tamaño PN: @usuario.tamanoPn</p>
                <p>Edad: @usuario.edadUsuario</p>
            </div>
        </div>
    } 
</div>
@code {
    public List<Usuario> lstUsuarios = new()
    {
        new Usuario("Juan Perez", "juan.perez@example.com", "https://i.pravatar.cc/150?img=12") { tamanoPn = 14.5m, edadUsuario = 28 },
        new Usuario("María Fernández", "maria.fernandez@example.com", "https://i.pravatar.cc/150?img=47") { tamanoPn = 12.0m, edadUsuario = 24 },
        new Usuario("Jorge Rojas", "jorge.rojas@example.com", "https://i.pravatar.cc/150?img=33") { tamanoPn = 15.2m, edadUsuario = 35 },
        new Usuario("Lucía Vargas", "lucia.vargas@example.com", "https://i.pravatar.cc/150?img=45") { tamanoPn = 11.8m, edadUsuario = 22 },
        new Usuario("Andrés Gutiérrez", "andres.gutierrez@example.com", "https://i.pravatar.cc/150?img=59") { tamanoPn = 13.6m, edadUsuario = 41 },
        new Usuario("Valeria Quispe", "valeria.quispe@example.com", "https://i.pravatar.cc/150?img=32") { tamanoPn = 12.4m, edadUsuario = 30 },
        new Usuario("Diego Mamani", "diego.mamani@example.com", "https://i.pravatar.cc/150?img=68") { tamanoPn = 16.1m, edadUsuario = 26 },
        new Usuario("Sofía Choque", "sofia.choque@example.com", "https://i.pravatar.cc/150?img=44") { tamanoPn = 10.9m, edadUsuario = 19 },
